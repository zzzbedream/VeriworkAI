{
  "name": "veriwork-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VeriWork AI — verified-human micro-work for AI training, paid in G$ on Celo (GoodBuilders Season 5).",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.12",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate",
    "abi:generate": "pnpm --filter @veriwork/shared abi:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.11",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.2"
  }
}

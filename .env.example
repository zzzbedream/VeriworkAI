# VeriWork AI — environment variables. Copy to `.env` (never commit real values).
# Values marked (secret) must live only in your secret manager / hosting env.

# ---------- Chain ----------
CHAIN_ID=42220                                   # 42220 Celo mainnet | 11142220 Celo Sepolia | 31337 anvil fork
CELO_RPC_URL=https://forno.celo.org              # primary RPC (use Alchemy/QuickNode in production)
CELO_RPC_FALLBACK_URLS=https://forno.celo.org    # comma-separated fallbacks
VERIWORK_CORE_ADDRESS=                           # from packages/contracts/deployments/<chainId>.json
AGENT_REGISTRY_ADDRESS=

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@localhost:5432/veriwork   # (secret)
SHADOW_DATABASE_URL=                                               # only for `prisma migrate dev`

# ---------- Web app ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_VERIWORK_CORE_ADDRESS=
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_WC_PROJECT_ID=                       # optional: enables WalletConnect (Reown Cloud project id)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=VeriWorkGoodBot
SESSION_SECRET=                                  # (secret) >= 32 random bytes, e.g. `openssl rand -base64 48`
SIWE_DOMAIN=localhost:3000                       # host the SIWE message must be bound to
ENGAGEMENT_REWARDS_ENABLED=false                 # true after GoodDollar approves the app
ENGAGEMENT_REWARDS_ADDRESS=0xb44fC3A592aDaA257AECe1Ae8956019EA53d0465   # dev contract; prod: 0x25db74CF4E7BA120526fd87e159CF656d94bAE43
ENGAGEMENT_APP_ADDRESS=                          # app address registered with applyApp
ENGAGEMENT_APP_SIGNER_PRIVATE_KEY=               # (secret) signs AppClaim typed data
E2E_MODE=0                                       # 1 only in Playwright runs: mock identity + mock wallet

# ---------- Worker keys (hot wallets with minimal roles) ----------
OPERATOR_PRIVATE_KEY=                            # (secret) OPERATOR_ROLE: batches, settlement, slashing, faucet relaying
GUARDIAN_PRIVATE_KEY=                            # (secret) GUARDIAN_ROLE: pause + veto only
AI_AGENT_PRIVATE_KEY=                            # (secret) the registered AI agent key that signs drafts

# ---------- Worker run mode ----------
WORKER_MODE=once                                 # once (cron runner, e.g. GitHub Actions every 15 min) | daemon (persistent host)
WEB_APP_URL=http://localhost:3000                # used for links in Telegram notifications

# ---------- Worker modules (true/false) ----------
WORKER_ENABLE_PIPELINE=true
WORKER_ENABLE_SETTLEMENT=true
WORKER_ENABLE_INDEXER=true
WORKER_ENABLE_SENTINEL=true
WORKER_ENABLE_TELEGRAM=true
WORKER_ENABLE_FAUCET_RELAYER=true

# ---------- AI contributor ----------
ANTHROPIC_API_KEY=                               # (secret) only needed with AI_PROVIDER=anthropic
AI_PROVIDER=fixture                              # fixture (curated demo drafts, offline) | anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium                                 # low | medium | high | xhigh | max

# ---------- Monitoring ----------
COINGECKO_API_KEY=                               # (secret) Demo key: 100 req/min, 10k/month -> poll every 5 min
SENTINEL_PRICE_DROP_PCT=15
SENTINEL_WINDOW_MINUTES=10
SENTINEL_OUTFLOW_WARN_PCT=80
SENTINEL_OUTFLOW_PAUSE_PCT=95

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=                              # (secret) from @BotFather
TELEGRAM_WEBHOOK_SECRET=                         # (secret) random 32+ chars; Telegram sends it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_ADMIN_CHAT_ID=                          # chat that receives critical alerts

# ---------- Contracts deployment (packages/contracts) ----------
DEPLOYER_PRIVATE_KEY=                            # (secret) temporary deployer; renounces admin after setup
ADMIN_ADDRESS=                                   # Safe multisig (threshold >= 2) — owns DEFAULT_ADMIN_ROLE
ALLOW_EOA_ADMIN=false                            # true only for a single-key demo admin (EOA, EIP-7702 account or 1-of-N Safe)
GUARDIAN_ADDRESS=                                # admin, guardian and operator must be three different addresses
OPERATOR_ADDRESS=
TREASURY_ADDRESS=                                # Safe or project treasury (80% of fees)
UBI_RECIPIENT=0x43d72Ff17701B2DA814620735C39C620Ce0ea4A1   # GoodDollar UBIScheme (20% of fees); must be canonical on 42220
# G_TOKEN= and IDENTITY= default to the canonical G$ / IdentityV4 on 42220; set them (and UBI_RECIPIENT) on Celo Sepolia
ALLOW_PROTOCOL_OVERRIDE=false                    # true only to deploy against non-canonical G$ / Identity / UBI on 42220
# Required on 42220. Caps: about 1.5-2x the Sunday 24h peak (sponsor/admin withdrawals get 30% of the core cap).
CORE_MAX_ROLLING_OUTFLOW=200000000000000000000000          # 200,000 G$ per rolling 24h
REGISTRY_MAX_ROLLING_OUTFLOW=10000000000000000000000       # 10,000 G$ per rolling 24h (bond refunds + slashes)
MAX_EPOCH_TOTAL=100000000000000000000000                   # 100,000 G$: about the largest expected weekly payout
PLATFORM_FEE_BPS=1000
STAKE_AMOUNT=150000000000000000000
AGENT_BOND=250000000000000000000
# DEPLOY_SALT=                                   # optional bytes32; default keccak256("VeriWork.v2")
ETHERSCAN_API_KEY=                               # Etherscan API v2 key (covers Celo, chainid 42220)
RUN_FORK_TESTS=false

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "db:generate": {
      "inputs": [
        "prisma/**",
        "prisma.config.ts"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate",
        "db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "out/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ],
      "outputs": [
        "coverage/**"
      ],
      "passThroughEnv": [
        "CI",
        "CELO_RPC_URL",
        "FOUNDRY_PROFILE"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_*",
        "E2E_*"
      ]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "SHADOW_DATABASE_URL"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "CELO_RPC_URL",
        "SESSION_SECRET",
        "TELEGRAM_BOT_TOKEN",
        "OPERATOR_PRIVATE_KEY",
        "GUARDIAN_PRIVATE_KEY",
        "ANTHROPIC_API_KEY",
        "COINGECKO_API_KEY"
      ]
    }
  }
}
